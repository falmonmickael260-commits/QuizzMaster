# Port HTTP (Next.js + WebSocket du jeu + API admin sur le même port)
PORT=3000

# Mot de passe de la régie /admin (obligatoire en production ; « admin » par défaut en développement)
ADMIN_PASSWORD=

# Stockage des questions : Supabase si ces deux variables sont définies, sinon fichier local data/store/questions.json
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Génération de questions par IA dans la régie (facultatif)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# Mode démo uniquement : multiplie toutes les durées de phase (1 = règles officielles)
# BQ_TIME_SCALE=1

# Interface hébergée séparément du serveur de jeu (ex. interface sur Vercel, serveur sur Railway) :
# à définir côté interface (Vercel), avec l'adresse publique du serveur de jeu. Redéployer après modification.
# NEXT_PUBLIC_GAME_SERVER_URL=https://blind-quizz.up.railway.app

# --- Intégration Revanche Game (optionnelle) ---
# Sans ces variables, Quiz Master fonctionne en jeu autonome, exactement
# comme avant. Voir docs/PLATFORM.md dans le repo revanche-games-web.
#
# Secret HMAC partagé avec la coquille, pour vérifier l'identité du joueur
# transmise via ?rg_token= à l'ouverture d'une partie.
# PLATFORM_SHARED_SECRET=
#
# Projet Supabase central (comptes, profils, statistiques) — distinct de
# SUPABASE_URL ci-dessus, qui ne sert qu'à la banque de questions.
# PLATFORM_SUPABASE_URL=https://wrsmtdtzilpckfcjmyri.supabase.co
# PLATFORM_SUPABASE_SERVICE_ROLE_KEY=    <-- secret, jamais commité
#
# Autorise la coquille Revanche Game à afficher ce jeu dans une iframe
# (sinon bloqué par la Content-Security-Policy par défaut). Adresse exacte
# de la coquille, sans slash final.
# PLATFORM_SHELL_ORIGIN=http://localhost:3001
