{
  "name": "blind-quizz",
  "version": "1.0.0",
  "private": true,
  "description": "BLIND QUIZZ — jeu télévisé 3D multijoueur de culture générale",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore ./src --ignore ./.next server/index.ts",
    "build": "next build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "questions:validate": "tsx scripts/validate-questions.ts",
    "questions:export": "tsx scripts/export-questions.ts",
    "supabase:seed": "tsx scripts/seed-supabase.ts",
    "e2e": "tsx e2e/full-game.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.3",
    "@supabase/supabase-js": "^2.117.2",
    "next": "^16.3.6",
    "postprocessing": "^6.39.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "ws": "^8.22.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
